# OpenTofu / Terraform working files
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files may contain secrets; commit only the examples
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local kubeconfigs and env
kubeconfig*
.env
.envrc

# Helm chart build artifacts
gitops/**/charts/
gitops/**/Chart.lock

# OS / editor
.DS_Store
.idea/
.vscode/

# GitHub App identity for coding agents (see README > Contributing); key lives outside the repo
.gh-app-identity.json
*.pem

# local/kind/openchoreo: generated per install, never committed (see its README > Credentials)
local/kind/openchoreo/.secrets.env
local/kind/openchoreo/.rendered/
local/kind/openchoreo/values-console.yaml
local/kind/openchoreo/.coredns-corefile.backup
